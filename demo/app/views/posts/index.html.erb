<% content_for :title, "Posts" %>

<div class="page-head page-head--row">
  <div>
    <h1>Bulletin</h1>
    <p>Published posts, <%= @sort == "likes" ? "most liked first" : "newest first" %>.</p>
  </div>
  <%= link_to "New post", new_post_path, class: "btn btn--primary" %>
</div>

<div class="btn-row" style="margin-bottom:1rem;align-items:center;gap:.75rem">
  <%= form_with url: posts_path, method: :get, class: "inline" do |f| %>
    <%= f.search_field :q, value: @query, placeholder: "Search posts…", class: "input", style: "width:16rem" %>
    <%= f.hidden_field :sort, value: @sort %>
    <%= f.submit "Search", class: "btn btn--sm btn--ghost" %>
  <% end %>
  <span class="dot"></span>
  <%= link_to "Newest", posts_path(q: @query.presence), class: "btn btn--sm #{'btn--primary' if @sort == 'newest'}" %>
  <%= link_to "Most liked", posts_path(q: @query.presence, sort: "likes"), class: "btn btn--sm #{'btn--primary' if @sort == 'likes'}" %>
</div>

<% if @posts.empty? %>
  <div class="empty">
    <% if @query.present? %>
      <p>Nothing matches “<%= @query %>”.</p>
      <%= link_to "Clear search", posts_path, class: "btn btn--ghost" %>
    <% else %>
      <p>No published posts yet.</p>
      <%= link_to "Write the first one", new_post_path, class: "btn btn--primary" %>
    <% end %>
  </div>
<% else %>
  <div class="stack">
    <% @posts.each do |post| %>
      <article class="card card-link post-card">
        <%= link_to post do %>
          <h2><%= post.title %></h2>
        <% end %>
        <p class="post-card__excerpt"><%= truncate(post.body.to_s, length: 140) %></p>
        <div class="meta" style="margin-top:.85rem">
          <%= byline post.author %>
          <span class="dot"></span>
          <span class="count">♥ <%= likes_count(post) %></span>
          <span class="dot"></span>
          <%= time_ago_in_words(post.created_at) %> ago
        </div>
      </article>
    <% end %>
  </div>
<% end %>
