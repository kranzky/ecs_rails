<%# Keep Kaminari's links and identify the current page for assistive technology. %>
<% if page.current? %>
  <span class="page current" aria-current="page"><%= page %></span>
<% else %>
  <span class="page"><%= link_to page, url, remote: remote, rel: page.rel, aria: { label: "Page #{page}" } %></span>
<% end %>
