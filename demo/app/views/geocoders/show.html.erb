<% content_for :title, "Geocoder" %>

<div class="page-head">
  <h1>The geocoder: one system, every address</h1>
  <p><code>Demo::Geocoder</code> gives each <code>Address</code> a
     <code>Geolocation</code> in the same slot. It reads the
     <code>addresses</code> table, so sellers' and customers' addresses are
     handled in one pass, and it never names <code>User</code> or
     <code>Company</code>.</p>
</div>

<div class="stack">
  <div class="notice-draft">
    <strong>Simulated coordinates.</strong> Lookups use a short built-in list of
    city centres (<code>Demo::Gazetteer</code>), nudged per address. No service
    is called, and the points are not real locations.
  </div>

  <div class="card">
    <h2 class="section-title">Map · <%= pluralize(@located_total, "located address") %></h2>
    <nav class="btn-row" aria-label="Show addresses owned by" style="margin-bottom:.75rem">
      <%= link_to "All · #{@model_counts.values.sum}", geocoder_path,
                  class: "btn btn--sm #{@model ? 'btn--ghost' : 'btn--primary'}", "aria-current": (@model ? nil : "page") %>
      <% @model_counts.each do |model, count| %>
        <%= link_to "#{model.humanize} · #{count}", geocoder_path(model: model),
                    class: "btn btn--sm #{model == @model ? 'btn--primary' : 'btn--ghost'}", "aria-current": (model == @model ? "page" : nil) %>
      <% end %>
    </nav>
    <p class="hint" style="margin:0 0 .75rem">
      <% if @owner_class %>
        <code>Geolocation.where(entity: <%= @owner_class.name %>.all)</code>: the component
        table has no idea what owns a row, so the type comes from the owner's scope.
      <% else %>
        Every located <code>Geolocation</code>, whatever owns it. Filter by the owning
        entity's type above; the address table below follows the same filter.
      <% end %>
    </p>
    <svg class="world-map" viewBox="<%= Demo::WorldMap::VIEW_BOX %>" role="img" aria-labelledby="world-map-title world-map-desc">
      <title id="world-map-title">Simulated geolocations on a world map</title>
      <desc id="world-map-desc"><%= pluralize(@markers.sum { |marker| marker.pins.size }, "point") %> in <%= pluralize(@markers.size, "place") %>, listed after the map.</desc>
      <path class="world-map__land" d="<%= Demo::WorldMap::LAND %>"/>
      <% labels = Demo::WorldMap.label_positions(@markers) %>
      <% @markers.each do |marker| %>
        <g class="world-map__marker">
          <title><%= marker.places.to_sentence %>: <%= owner_types_text(marker.owner_types) %></title>
          <circle cx="<%= marker.x.round(2) %>" cy="<%= marker.y.round(2) %>" r="<%= marker.radius %>"/>
          <% if (x, y, anchor = labels[marker]) %>
            <text class="world-map__label" x="<%= x.round(2) %>" y="<%= y.round(2) %>" text-anchor="<%= anchor %>"><%= marker.label %></text>
          <% end %>
        </g>
      <% end %>
    </svg>
    <% if @markers.empty? %>
      <p class="empty" style="margin-top:.75rem">Nothing located yet. Run the geocoder below.</p>
    <% else %>
      <h3 class="section-title" style="margin:1rem 0 .5rem">Places on the map</h3>
      <ul class="map-places">
        <% @markers.each do |marker| %>
          <li><strong><%= marker.places.to_sentence %></strong> <span class="count"><%= owner_types_text(marker.owner_types) %></span></li>
        <% end %>
      </ul>
    <% end %>
    <% if @located_total > GeocodersController::MAP_LIMIT %>
      <p class="hint">Showing the first <%= GeocodersController::MAP_LIMIT %> of <%= @located_total %> points.</p>
    <% end %>
  </div>

  <div class="card">
    <div class="btn-row" style="justify-content:space-between;align-items:center;margin-bottom:.75rem">
      <h2 class="section-title" style="margin:0">Addresses · <%= @addresses.total_count %></h2>
      <%= button_to "Run the geocoder", geocoder_path, class: "btn btn--sm btn--primary" %>
    </div>
    <p class="hint" style="margin:0 0 .75rem">An address is <em>waiting</em>
       when its pair is missing or older than the address. Edit an address on a
       <%= link_to "person's page", users_path %>, come back, and run the
       geocoder again: only that address is redone. Orders and invoices keep
       address snapshots with no <code>Geolocation</code> declared, so they are
       not paired and never geocoded.</p>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr><th scope="col">Owner</th><th scope="col">Slot</th><th scope="col">Address</th><th scope="col">Geolocation</th><th scope="col">State</th></tr>
        </thead>
        <tbody>
          <% @addresses.each do |address| %>
            <% geolocation = @geolocations[[address.entity_id, address.slot]] %>
            <% state = geocoding_state(address, geolocation) %>
            <tr>
              <td>
                <span class="badge"><%= address.entity.class.name %></span>
                <%= link_to owner_label(address.entity), address.entity %>
              </td>
              <td><code><%= address.slot.presence || "(default)" %></code></td>
              <td><%= address.one_line.presence || "—" %></td>
              <td class="coords">
                <% if geolocation&.geocoded? %>
                  <%= coordinates_for(geolocation) %>
                <% else %>
                  <span style="color:var(--faint)">—</span>
                <% end %>
              </td>
              <td><%= geocoding_badge(state) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @addresses, window: 1, outer_window: 1 %>
  </div>

  <div class="grid grid--2">
    <div class="card">
      <h3 class="section-title">Declared, not configured</h3>
      <p class="prose">Pairing is two declarations in the same slot. The
         geocoder asks each owner's class whether it declares the pair, so a
         new entity type joins in without a change to the system.</p>
      <pre class="code-block"><code>class User &lt; ApplicationEntity
  component Address,     prefix: :shipping
  component Geolocation, prefix: :shipping
  component Address,     prefix: :billing
  component Geolocation, prefix: :billing
end

class Company &lt; ApplicationEntity
  component Address
  component Geolocation
end</code></pre>
    </div>
    <div class="card">
      <h3 class="section-title">Still one migration</h3>
      <p class="prose">The <code>geolocations</code> table was created by
         <code>rails g ecs_rails:install</code> along with the rest of the
         catalogue. Adding the geocoder needed no new table and no migration.
         <code>db/migrate</code> holds:</p>
      <pre class="code-block"><code><% @migrations.each do |name| %><%= name %>
<% end %></code></pre>
      <p class="prose" style="margin-bottom:0">Read the
         <a href="https://github.com/kranzky/ecs_rails/blob/main/demo/lib/demo/geocoder.rb">geocoder's source</a>
         on GitHub.</p>
    </div>
  </div>
</div>
