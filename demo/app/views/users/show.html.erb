<% content_for :title, display_name(@user) %>

<%= link_to "← Back to people", users_path, class: "back" %>

<div class="card">
  <div class="profile">
    <%= avatar_for @user, klass: "avatar avatar--lg" %>
    <div class="profile__meta">
      <h1 class="profile__name"><%= display_name @user %></h1>
      <div class="meta"><%= @user.email_address %></div>
      <div class="profile__badges">
        <% if @user.administrator? %><span class="badge badge--admin">★ Admin</span><% end %>
        <% if @user.moderator? %><span class="badge badge--mod">Moderator</span><% end %>
      </div>
    </div>
  </div>

  <% if @user.bio.present? %>
    <p class="prose" style="margin:1rem 0 0;color:var(--muted)"><%= @user.bio %></p>
  <% end %>

  <hr class="divider">

  <h3 class="section-title">Roles — presence via add / remove</h3>
  <div class="btn-row">
    <% if @user.moderator? %>
      <%= button_to "Remove moderator", user_moderator_path(@user), method: :delete, class: "btn btn--sm btn--danger", form_class: "inline" %>
    <% else %>
      <%= button_to "Make moderator", user_moderator_path(@user), class: "btn btn--sm", form_class: "inline" %>
    <% end %>
    <% if @user.administrator? %>
      <%= button_to "Remove admin", user_administrator_path(@user), method: :delete, class: "btn btn--sm btn--danger", form_class: "inline" %>
    <% else %>
      <%= button_to "Make admin", user_administrator_path(@user), class: "btn btn--sm", form_class: "inline" %>
    <% end %>
  </div>
</div>

<section style="margin-top:2rem">
  <div class="page-head page-head--row" style="margin-bottom:.75rem">
    <h2 class="section-title" style="margin:0">Contact — two Address slots, two Phone slots</h2>
    <span class="btn-row">
      <%= link_to "Basket", user_basket_path(@user), class: "btn btn--sm btn--ghost" %>
      <%= link_to "Orders", user_orders_path(@user), class: "btn btn--sm btn--ghost" %>
    </span>
  </div>
  <div class="card">
    <p class="hint" style="margin:0 0 1rem">The same <code>Address</code> component declared twice, <code>prefix: :shipping</code> and <code>prefix: :billing</code>, and <code>Phone</code> as <code>mobile</code> and <code>work</code> — one row per slot in the shared tables, and none at all until a field is filled.</p>
    <%= form_with url: user_path(@user), method: :patch do |f| %>
      <div class="grid grid--2">
        <% %w[shipping billing].each do |slot| %>
          <% address = @user.public_send("#{slot}_address") %>
          <div>
            <h3 class="section-title"><%= slot.capitalize %> address</h3>
            <% [["line1", "Line 1"], ["locality", "City"], ["region", "Region"], ["postcode", "Postcode"], ["country", "Country (2 letters)"]].each do |field, label| %>
              <div class="field" style="margin-bottom:.6rem">
                <%= f.label "contact[#{slot}][#{field}]", label %>
                <%= f.text_field "contact[#{slot}][#{field}]", value: address.public_send(field), class: "input", maxlength: (field == "country" ? 2 : 80) %>
              </div>
            <% end %>
          </div>
        <% end %>
        <div class="field"><%= f.label "contact[mobile]", "Mobile phone (E.164)" %><%= f.text_field "contact[mobile]", value: @user.mobile_phone.e164, class: "input", placeholder: "+61412345678" %></div>
        <div class="field"><%= f.label "contact[work]", "Work phone (E.164)" %><%= f.text_field "contact[work]", value: @user.work_phone.e164, class: "input", placeholder: "+61892345678" %></div>
      </div>
      <%= f.submit "Save contact details", class: "btn btn--sm btn--primary" %>
    <% end %>
  </div>
</section>

<section style="margin-top:2rem">
  <h2 class="section-title">Posts by <%= @user.name_given %> · <%= @posts.size %></h2>
  <% if @posts.empty? %>
    <div class="empty">No posts yet.</div>
  <% else %>
    <div class="stack stack--tight">
      <% @posts.each do |post| %>
        <%= link_to post, class: "card card-link #{'is-draft' if post.draft?}" do %>
          <div class="btn-row" style="justify-content:space-between;align-items:baseline">
            <strong style="color:var(--text)"><%= post.title %></strong>
            <% if post.draft? %><span class="badge badge--draft">Draft</span><% end %>
          </div>
          <div class="meta" style="margin-top:.3rem"><span class="count">♥ <%= likes_count(post) %></span></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
