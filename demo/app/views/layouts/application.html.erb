<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Bulletin" : "Bulletin — built on ECS Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%234f46e5'/><text x='50' y='70' font-size='60' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'>E</text></svg>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <%# Keyboard users skip the navigation and acting-as bar (13 stops). %>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="site-nav" aria-label="Main">
      <div class="site-nav__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark">E</span> Bulletin
        <% end %>
        <div class="site-nav__links">
          <%= nav_link "Start here", root_path, active: current_page?(root_path) %>
          <%= nav_link "Posts", posts_path, active: controller_name == "posts" %>
          <%= nav_link "People", users_path, active: controller_name == "users" %>
          <%= nav_link "Groups", groups_path, active: %w[groups memberships].include?(controller_name) %>
          <%= nav_link "Market", products_path, active: %w[products reviews].include?(controller_name) %>
          <%= nav_link "Sellers", companies_path, active: controller_name == "companies" %>
          <%= nav_link "How it works", about_path, active: current_page?(about_path) %>
        </div>
      </div>
    </nav>

    <%= render "layouts/acting_as" %>
    <%= render "layouts/reset_banner" %>

    <main id="main" tabindex="-1">
      <%# Alerts interrupt a screen reader; notices wait their turn. %>
      <% if flash.any? %>
        <div class="flash">
          <% flash.each do |type, message| %>
            <% alert = type == "alert" %>
            <div class="flash__msg flash__msg--<%= alert ? "alert" : "notice" %>" role="<%= alert ? "alert" : "status" %>">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Built on <strong>ECS Rails</strong> — a component-based reimagining of ActiveRecord.</span>
        <span class="site-footer__links">
          <%= link_to "GitHub", "https://github.com/kranzky/ecs_rails" %>
          <span class="dot"></span>
          <%= link_to "RubyGems", "https://rubygems.org/gems/ecs_on_rails" %>
        </span>
      </div>
    </footer>
  </body>
</html>
