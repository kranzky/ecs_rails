# frozen_string_literal: true

# The ECS Rails install migration: the single `entities` table every entity
# shares, and the single `relationships` table every `relates_to` is a row of.
# See docs/architecture.md §2, docs/adr/0002-single-entities-table.md and
# docs/adr/0017-shared-relationships-table.md.
class EcsRailsInstall < ActiveRecord::Migration[<%= migration_version %>]
  def change
    # gen_random_uuid() lives in pgcrypto on PostgreSQL < 13; enabling it is
    # harmless on 13+, where the function is built in.
    enable_extension "pgcrypto" unless extension_enabled?("pgcrypto")

    create_table :entities, id: :uuid, default: -> { "gen_random_uuid()" } do |t|
      # The entity subclass discriminator, e.g. "users". Indexed because
      # User.all compiles to WHERE model = 'users'.
      t.string :model, null: false, index: true
      t.datetime :created_at, null: false
      # No updated_at — an entity is written once and never changes.
      # See RFC-0001 and docs/architecture.md §1.
    end

    # Every relationship in the application is a row here (ADR-0017): the owner
    # is entity_id, the relationship name is the slot, the pointed-at entity is
    # target_id. Declaring `relates_to :author, User` on an entity needs no
    # migration — this table already exists.
    create_table :relationships, id: :uuid, default: -> { "gen_random_uuid()" } do |t|
      t.uuid    :entity_id,   null: false
      t.string  :slot,        null: false, default: ""
      t.uuid    :target_id,   default: nil
      # A copy of the owner's entities.model, so exclusivity is per owner type
      # and the inverse has_many (RFC-0015) has a cheap scope.
      t.string  :owner_model, null: false
      # Written true by `relates_to ..., unique: true`; the partial index below
      # then makes the link one-to-one at the database.
      t.boolean :exclusive,   null: false, default: false
      t.timestamps
    end

    # ADR-0005 / ADR-0015: one target per (owner, relationship name).
    add_index :relationships, [:entity_id, :slot], unique: true
    # Inverse lookups — "who points at this entity under this name" (RFC-0015).
    add_index :relationships, [:target_id, :slot]
    # `unique: true` relationships: at most one owner of a given type pointing at
    # a given target under a given name — has_one, enforced here, once, for every
    # exclusive relationship the application will ever declare.
    add_index :relationships, [:target_id, :slot, :owner_model], unique: true, where: "exclusive",
                                                                 name: "index_relationships_exclusive"

    # Destroying the owner destroys the link. Destroying the TARGET nullifies it —
    # the owner survives with the link cleared — never cascading to the owner.
    add_foreign_key :relationships, :entities, column: :entity_id, on_delete: :cascade
    add_foreign_key :relationships, :entities, column: :target_id, on_delete: :nullify
  end
end
