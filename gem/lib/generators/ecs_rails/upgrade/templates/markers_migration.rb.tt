# frozen_string_literal: true

# Moves markers onto the shared `markers` table (ADR-0018 §4).
#
# A marker has no state: an entity IS a moderator exactly when its row exists.
# Every marker is a row here, the slot being the marker name, so declaring
# `marker :moderator` no longer needs a table of its own.
#
# Generated by `rails g ecs_rails:upgrade`, which found the tables below by
# their shape: component tables with no attribute columns at all. Review the
# list before running — each is copied into `markers` under its singular name
# and dropped. Irreversible, hence `up`/`down`.
class EcsRailsSharedMarkers < ActiveRecord::Migration[<%= migration_version %>]
  def up
<% unless markers_table_exists? -%>
    create_table :markers, id: :uuid, default: -> { "gen_random_uuid()" } do |t|
      t.uuid   :entity_id, null: false
      t.string :slot,      null: false, default: ""
      t.timestamps
    end
    add_index :markers, [:entity_id, :slot], unique: true
    add_foreign_key :markers, :entities, column: :entity_id, on_delete: :cascade
<% end -%>
<% marker_tables.each do |marker| -%>

    # <%= marker[:table] %> -> slot "<%= marker[:slot] %>"
    execute <<~SQL
      INSERT INTO markers (id, entity_id, slot, created_at, updated_at)
      SELECT id, entity_id, '<%= marker[:slot] %>', created_at, updated_at
      FROM <%= marker[:table] %>
    SQL
    drop_table :<%= marker[:table] %>
<% end -%>
  end

  def down
    raise ActiveRecord::IrreversibleMigration, "the per-marker tables were dropped"
  end
end
