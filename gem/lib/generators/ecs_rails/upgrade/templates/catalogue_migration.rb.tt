# frozen_string_literal: true

# Brings this application's catalogue tables up to the installed gem's schema
# declarations (ADR-0018): creates the tables a newer gem version or a newly
# added set introduces, and adds the columns or indexes an existing table
# predates. Nothing is dropped or altered.
#
# Generated by `rails g ecs_rails:upgrade` from EcsRails::Catalogue — the same
# declarations the install migration was rendered from.
class EcsRailsCatalogue < ActiveRecord::Migration[<%= migration_version %>]
  def change
<% catalogue_changes.each_with_index do |change, i| -%>
<%= "\n" unless i.zero? -%>
    # <%= change[:component].class_name %> (<%= change[:component].set %>)
<%= change[:source] %>
<% end -%>
  end
end
