# frozen_string_literal: true

# Adds the slot column to every existing component table (RFC-0014 / ADR-0015).
#
# A component may now be declared more than once on an entity under distinct
# labels (`component PostalAddress, prefix: :business`); the `slot` column is
# the label, "" for the singular default. The one-per-entity unique index
# (ADR-0005) becomes one-per-(entity, slot). Safe on existing data: every row
# already here is the single slot = "" row, so the new index admits exactly what
# the old one did.
#
# Generated by `rails g ecs_rails:upgrade`, which found these tables by looking
# for an entity_id column and no slot column.
class EcsRailsAddSlots < ActiveRecord::Migration[<%= migration_version %>]
  def change
<% tables_missing_slot.each do |table| -%>
    add_column :<%= table %>, :slot, :string, null: false, default: ""
    remove_index :<%= table %>, column: :entity_id, unique: true
    add_index :<%= table %>, [:entity_id, :slot], unique: true
<%= "\n" unless table == tables_missing_slot.last -%>
<% end -%>
  end
end
